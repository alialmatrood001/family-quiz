{
  "name": "family-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "npm run emulators",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,functions,firestore,database",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --only auth,functions,firestore,database --import=./emulator-data",
    "emulators:check": "node scripts/check-emulator-connection.mjs",
    "emulators:create-admin": "node scripts/create-emulator-admin.mjs",
    "emulators:exec:check": "firebase emulators:exec --only auth,functions,firestore,database \"npm run emulators:check\"",
    "test:unit": "npm --prefix functions run test:unit",
    "test:admin-flow": "firebase emulators:exec --project demo-family-quiz --only auth,functions,firestore,database \"node --test --test-concurrency=1 functions/tests/integration/admin-client-flow.test.mjs\"",
    "test:finalization-ui": "npm run test:admin-flow",
    "test:baseline": "firebase emulators:exec --project demo-family-quiz --only auth,functions,firestore,database \"npm --prefix functions run test:baseline\"",
    "test:baseline:50": "firebase emulators:exec --project demo-family-quiz --only auth,functions,firestore,database \"npm --prefix functions run test:baseline:50\"",
    "test:baseline:edge": "firebase emulators:exec --project demo-family-quiz --only auth,functions,firestore,database \"npm --prefix functions run test:baseline:edge\"",
    "test:baseline:performance": "firebase emulators:exec --project demo-family-quiz --only auth,functions,firestore,database \"npm --prefix functions run test:baseline:performance\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
