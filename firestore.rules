// DEVELOPMENT EMULATOR RULES — DO NOT DEPLOY
// These permissive rules exist only so the current unauthenticated application
// can be exercised locally. Replace them with authenticated production rules.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
