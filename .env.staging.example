# Browser variables (public; bundled by Vite, never put secrets here).
VITE_APP_ENV=staging
VITE_SERVER_TRANSPORT=vercel
VITE_STAGING_BANNER=true
VITE_FIREBASE_API_KEY=REPLACE_WITH_STAGING_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_STAGING_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_STAGING_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_STAGING_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_STAGING_APP_ID

# Server identity and target guards (server-only; project IDs and URLs are not secrets).
APP_ENVIRONMENT=staging
SERVER_TRANSPORT=vercel
# VERCEL_ENV is supplied by Vercel and must equal production in this isolated Staging project.
FIREBASE_ADMIN_AUTH_MODE=oidc
FIREBASE_ADMIN_PROJECT_ID=family-quiz-staging
FIREBASE_PRODUCTION_PROJECT_ID=family-quiz-b7960
CONFIRM_STAGING_PROJECT=family-quiz-staging
FIREBASE_DATABASE_URL=https://family-quiz-staging.firebaseio.com
STAGING_ORIGIN=https://REPLACE_WITH_STAGING_VERCEL_ORIGIN
PRODUCTION_ORIGIN=https://REPLACE_WITH_PRODUCTION_ORIGIN
VERCEL_ALLOWED_ORIGINS=https://REPLACE_WITH_STAGING_VERCEL_ORIGIN

# Keyless Google Workload Identity Federation configuration (server-only).
GOOGLE_CLOUD_PROJECT=family-quiz-staging
GCP_PROJECT_NUMBER=110839511131
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-staging
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=vercel-staging
GCP_SERVICE_ACCOUNT_EMAIL=vercel-staging-firebase-admin@family-quiz-staging.iam.gserviceaccount.com
VERCEL_OIDC_ISSUER=https://oidc.vercel.com/ali-almatrood-s-projects
VERCEL_OIDC_AUDIENCE=https://vercel.com/ali-almatrood-s-projects
VERCEL_OIDC_SUBJECT=owner:ali-almatrood-s-projects:project:family-quiz-staging:environment:production

# VERCEL_OIDC_TOKEN is supplied by Vercel. Do not define, persist, or log it.
# Legacy emergency option only: switch FIREBASE_ADMIN_AUTH_MODE to legacy-key,
# remove all OIDC variables above, then provide the two encrypted server values below.
# FIREBASE_ADMIN_CLIENT_EMAIL=REPLACE_WITH_MANAGED_STAGING_CLIENT_EMAIL
# FIREBASE_ADMIN_PRIVATE_KEY=REPLACE_WITH_MANAGED_STAGING_PRIVATE_KEY

# Test target guards (local/CI only; never point these at Production).
TEST_STAGING_BASE_URL=https://REPLACE_WITH_STAGING_VERCEL_ORIGIN
TEST_STAGING_PROJECT_ID=REPLACE_WITH_STAGING_PROJECT_ID
CONFIRM_STAGING_LOAD_TARGET=REPLACE_WITH_STAGING_PROJECT_ID
