{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm --prefix .. run staging:deploy:dry-run",
    "logs": "firebase functions:log",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:baseline": "npm run test:unit && node --test --test-concurrency=1 tests/integration/baseline-50.test.mjs tests/integration/idempotency.test.mjs tests/integration/edge-cases.test.mjs",
    "test:baseline:50": "node --test --test-concurrency=1 tests/integration/baseline-50.test.mjs",
    "test:baseline:edge": "node --test --test-concurrency=1 tests/integration/edge-cases.test.mjs",
    "test:baseline:performance": "node --test --test-concurrency=1 tests/integration/performance.test.mjs",
    "test:secure-writes": "node --test --test-concurrency=1 tests/integration/secure-writes-flow.test.mjs",
    "test:secure-writes:performance": "node --test --test-concurrency=1 tests/integration/secure-writes-performance.test.mjs",
    "test:privacy": "node --test --test-concurrency=1 tests/integration/player-privacy.test.mjs tests/integration/player-private-migration.test.mjs tests/integration/staging-smoke.test.mjs tests/integration/staging-guard.test.mjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "google-auth-library": "^10.7.0"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
